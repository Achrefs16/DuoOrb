{
  "name": "duoorb-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=@duoorb/game-core",
    "build:core": "npm run build --workspace=@duoorb/game-core",
    "mobile": "npm run start --workspace=@duoorb/mobile",
    "server": "npm run start:dev --workspace=@duoorb/server"
  }
}
