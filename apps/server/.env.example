# Copy to .env and fill in real values. Never commit .env.

PORT=4000

# Supabase Auth
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# PostgreSQL connection string.
# Local docker-compose default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/duoorb?schema=public"
# Supabase pooler alternative:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Public base URL rendered inside /legal pages (no trailing slash).
# e.g. https://duoorbapi.duckdns.org
PUBLIC_BASE_URL="https://duoorbapi.duckdns.org"
# Support inbox shown on legal pages.
LEGAL_CONTACT_EMAIL="digitalas.support@gmail.com"
