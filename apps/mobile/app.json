{
  "expo": {
    "name": "DuoOrb",
    "slug": "duoorb",
    "scheme": "duoorb",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.asdigital.duoorb",
      "supportsTablet": true
    },
    "android": {
      "package": "com.asdigital.duoorb",
      "versionCode": 8,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
          "foregroundImage": "./assets/adaptive-foreground-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/Glossy Orbital Duo Logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "1f8dff36-4db8-4f75-bed3-4e0880689221"
      }
    },
    "owner": "achrefs",
    "plugins": [
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-400.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6057010656402010~3789437235",
          "androidSdk": "classic"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ]
    ]
  }
}
