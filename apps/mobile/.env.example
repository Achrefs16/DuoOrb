# Copy to .env and fill in real values. Never commit .env.
# NOTE: EXPO_PUBLIC_* values are embedded in the client bundle and are public.
# Only use publishable/anon keys here, never the Supabase secret key.

EXPO_PUBLIC_SERVER_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override where Privacy/Terms/Delete links point.
# Unset = SERVER_URL + /legal/privacy etc. (recommended for now).
# EXPO_PUBLIC_LEGAL_BASE_URL=https://duoorbapi.duckdns.org
# Shown in Settings > Legal.
# EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=digitalas.support@gmail.com
