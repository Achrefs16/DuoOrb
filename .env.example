# Copy to .env and fill in real values.
# Docker Compose reads this file automatically from the repo root.
# NEVER commit the real .env.

# --- Database (docker-compose Postgres) ---
# Password for the bundled Postgres container. Change this from the default
# before exposing anything to the internet.
POSTGRES_PASSWORD=change-me

# --- Guest sign-in (server only, never sent to clients) ---
# Signs the short-lived access tokens issued to players who continue as guest.
# Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Leave empty and guest sign-in is simply disabled (it fails closed).
# To rotate without downtime, list old and new separated by a comma: the
# FIRST key signs, and all of them verify.
GUEST_TOKEN_SECRET=

# --- Web CORS allowlist ---
# Browser origins permitted to call the API and open a game socket.
# Comma-separated. Native builds ignore CORS entirely (it is a browser
# mechanism), so this only matters if you ship a web version.
#   CORS_ORIGINS=https://duoorb.com,https://www.duoorb.com
# Unset = local development origins only, which is the safe default.
# Set to "*" only if there is no web build at all.
CORS_ORIGINS=

# --- Supabase (server-side auth verification) ---
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=
# Supabase publishable key (safe to expose to clients, still keep out of git)
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key - NEVER commit. Rotate if this file is ever shared.
SUPABASE_SECRET_KEY=
# JWKS endpoint used to verify Supabase JWTs
SUPABASE_JWKS_URL=
